#!/bin/bash
set -euo pipefail

BUILDER_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"

usage() {
    cat >&2 <<'EOF'
dbs — Drone Build System

Usage:
  dbs init [DIR]                      Scaffold a minimal buildable debian/ in DIR
                                      (default: current directory). Package name
                                      is the directory's basename. No changelog —
                                      dbs synthesises one from git at build time.
                                      Each template file (debian/control,
                                      debian/rules, .github/workflows/
                                      build-debs.yml) is checked individually;
                                      missing ones are added and existing ones
                                      are left untouched, so init can be re-run
                                      to fill in whatever is missing.

  dbs [PROJECT_DIR] [options] [-- docker-build-args]
                                      Cross-build PROJECT_DIR (default: current
                                      directory). Packages land in
                                      PROJECT_DIR/out/<dist>/<arch>/. A
                                      PROJECT_DIR whose name starts with '-'
                                      must be written as ./name or given
                                      after --.

Build options:
  -d, --dist bookworm|trixie   Target Debian suite        (default: trixie)
  -a, --arch 32|64             Target ARM word size        (default: 64)
                               32 -> armhf, 64 -> arm64
  -l, --local                  Emit raw build artifacts into
                               PROJECT_DIR/build/<dist>/<arch>/ instead of
                               .deb packages in out/<dist>/<arch>/
  -n, --native                 Build natively inside the emulated target-arch
                               container (QEMU) instead of cross-compiling.
                               Slower, but builds packages that don't
                               cross-compile (e.g. opencv's Python/Java
                               bindings).
  -p, --publish                Copy the built .deb packages into the local
                               package repo so other projects can use them as
                               Build-Depends. Without this, builds stay in
                               out/<dist>/<arch>/ only.
  --host-deps "PKG..."         Extra build packages for build tools the
                               auto-detection can't classify (e.g.
                               protobuf-compiler). Repeatable; space-separated.
                               Cross: installed on the amd64 build host (Debian
                               main only). Native: installed in the target-arch
                               container (Debian/Pi/dronerepo). A project may also
                               list them in debian/dbs-host-deps (one per line,
                               '#' comments).
  --build-var KEY=VALUE        Forward an environment variable into the build,
                               where debian/rules can read it as a make variable
                               ($(KEY)) to vary the build — e.g. select a product
                               variant. Repeatable. KEY must be a valid shell
                               identifier ([A-Za-z_][A-Za-z0-9_]*).
  -h, --help                   Show this help

  Short flags may be bundled: -np is the same as -n -p, and a
  value-taking flag may end a bundle, so -npa 32 means -n -p -a 32.

Local package repo:
  dbs keeps a clone of the project package repo
  (git@github.com:DroneProUkr/droneprorepo.git) at ~/dbs/droneprorepo and uses
  its pool/<dist>/main/ directories as a local file repo, so a package built
  earlier can satisfy another project's Build-Depends. With -p/--publish, dbs
  first runs git pull on the clone (resolving any divergence toward the higher
  package version, and toward the local copy when versions match), then copies
  built packages into that pool, keeping only the newest version of each
  package+arch (older duplicates are removed). Building an older version than the
  one already in the repo prints a warning and is NOT published. dbs never runs
  git add/commit on the published .deb files — review and commit them yourself.
  Override the ~/dbs root with DBS_HOME, or point at an existing checkout with
  DBS_REPO_DIR.
EOF
}

# --------------------------------------------------------------------------
# dbs init — scaffold a minimal, buildable debian/ directory
# --------------------------------------------------------------------------
cmd_init() {
    local target="$PWD"
    if [ "${1:-}" != "" ]; then
        target="$1"
    fi
    target="$(cd -- "$target" && pwd)"

    local name pkg
    name="$(basename -- "$target")"
    # Debian source/binary package names must be lowercase and match
    # [a-z0-9][a-z0-9+.-]+ — sanitise the directory name into that shape.
    pkg="$(printf '%s' "$name" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9+.-]+/-/g; s/^[-+.]+//; s/[-+.]+$//')"
    [ -z "$pkg" ] && pkg="package"
    if [ "$pkg" != "$name" ]; then
        echo "dbs init: package name '$pkg' (sanitised from directory '$name')" >&2
    fi

    # Each template file is checked and created independently, so init can be
    # re-run on a partially-scaffolded project to fill in whatever is missing —
    # an existing file is always left untouched rather than clobbered.
    local created=0 present=0

    require_tmpl() {
        [ -f "$1" ] && return 0
        echo "dbs init: missing template '$1' — broken dbs installation" >&2
        exit 1
    }

    # debian/control — @PKG@ substituted with the (sanitised) package name.
    local control_tmpl="$BUILDER_DIR/templates/control"
    local control_dest="$target/debian/control"
    require_tmpl "$control_tmpl"
    if [ -e "$control_dest" ]; then
        echo "dbs init: 'debian/control' already exists — leaving it untouched" >&2
        present=$((present + 1))
    else
        mkdir -p "$target/debian"
        local control
        control="$(cat "$control_tmpl")"
        printf '%s\n' "${control//@PKG@/$pkg}" > "$control_dest"
        echo "dbs init: created debian/control" >&2
        created=$((created + 1))
    fi

    # debian/rules — copied verbatim and made executable.
    local rules_tmpl="$BUILDER_DIR/templates/rules"
    local rules_dest="$target/debian/rules"
    require_tmpl "$rules_tmpl"
    if [ -e "$rules_dest" ]; then
        echo "dbs init: 'debian/rules' already exists — leaving it untouched" >&2
        present=$((present + 1))
    else
        mkdir -p "$target/debian"
        cp "$rules_tmpl" "$rules_dest"
        chmod +x "$rules_dest"
        echo "dbs init: created debian/rules" >&2
        created=$((created + 1))
    fi

    # GitHub Actions workflow that cross-builds the matrix and publishes a
    # release on the default branch. The template is generic (it derives the
    # repo/image from the GitHub context), so it is copied verbatim.
    local wf_tmpl="$BUILDER_DIR/templates/build-debs.yml"
    local wf_dest="$target/.github/workflows/build-debs.yml"
    require_tmpl "$wf_tmpl"
    if [ -e "$wf_dest" ]; then
        echo "dbs init: '.github/workflows/build-debs.yml' already exists — leaving it untouched" >&2
        present=$((present + 1))
    else
        mkdir -p "$target/.github/workflows"
        cp "$wf_tmpl" "$wf_dest"
        echo "dbs init: created .github/workflows/build-debs.yml" >&2
        created=$((created + 1))
    fi

    if [ "$created" -eq 0 ]; then
        echo "dbs init: all template files already present in $target — nothing to do" >&2
    else
        echo "dbs init: package '$pkg' in $target ($created added, $present already present)" >&2
        echo "dbs init: build it with 'dbs' (from $target)" >&2
    fi
}

# --------------------------------------------------------------------------
# subcommand dispatch
# --------------------------------------------------------------------------
case "${1:-}" in
    init)        shift; cmd_init "$@"; exit 0 ;;
    -h|--help)   usage; exit 0 ;;
esac

# --------------------------------------------------------------------------
# build
# --------------------------------------------------------------------------
DIST="trixie"
ARCH="64"
LOCAL=0
NATIVE=0
PUBLISH=0
HOST_DEPS=""
BUILD_VARS=()
PROJECT_DIR="$PWD"
DOCKER_ARGS=()
project_set=0

need_val() { [ "$2" -ge 2 ] || { echo "dbs: option '$1' requires a value" >&2; exit 1; }; }

expand_short_opts() {
    EXPANDED=()
    while [ $# -gt 0 ]; do
        local arg="$1"; shift
        case "$arg" in
            --) EXPANDED+=("$arg" "$@"); return ;;
            -[!-]?*)
                local opt="${arg#-}" cluster=() consume="" ok=1 c
                while [ -n "$opt" ]; do
                    c="${opt:0:1}"; opt="${opt:1}"
                    case "$c" in
                        l|n|p|h) cluster+=("-$c") ;;
                        d|a)
                            if [ -n "$opt" ]; then
                                cluster+=("-$c" "${opt#=}"); opt=""
                            else
                                consume="-$c"   # value comes from the next argv token
                            fi
                            ;;
                        *) ok=0; break ;;       # not a clean cluster — leave it alone
                    esac
                done
                if [ "$ok" -eq 0 ]; then
                    EXPANDED+=("$arg")
                else
                    EXPANDED+=(${cluster[@]+"${cluster[@]}"})
                    if [ -n "$consume" ]; then
                        if [ $# -gt 0 ] && [ "$1" != "--" ]; then
                            EXPANDED+=("$consume" "$1"); shift
                        else
                            echo "dbs: option '$consume' requires a value" >&2; exit 1
                        fi
                    fi
                fi
                ;;
            *) EXPANDED+=("$arg") ;;
        esac
    done
}
expand_short_opts "$@"
set -- ${EXPANDED[@]+"${EXPANDED[@]}"}

while [ $# -gt 0 ]; do
    case "$1" in
        # short -d/-a (incl. -d=val and bundled) are normalised to '-d val' by
        # expand_short_opts above, so only the long =forms reach these arms.
        --dist|-d)     need_val "$1" "$#"; DIST="$2"; shift 2 ;;
        --dist=*)      DIST="${1#*=}";   shift ;;
        --arch|-a)     need_val "$1" "$#"; ARCH="$2"; shift 2 ;;
        --arch=*)      ARCH="${1#*=}";   shift ;;
        --local|-l)    LOCAL=1;          shift ;;
        --native|-n)   NATIVE=1;         shift ;;
        --publish|-p)  PUBLISH=1;        shift ;;
        --host-deps)   need_val "$1" "$#"; HOST_DEPS="$HOST_DEPS $2"; shift 2 ;;
        --host-deps=*) HOST_DEPS="$HOST_DEPS ${1#*=}"; shift ;;
        --build-var)   need_val "$1" "$#"; BUILD_VARS+=("$2"); shift 2 ;;
        --build-var=*) BUILD_VARS+=("${1#*=}"); shift ;;
        -h|--help) usage; exit 0 ;;
        --)        shift; DOCKER_ARGS+=("$@"); break ;;
        *)
            if [ "$project_set" -eq 0 ]; then
                PROJECT_DIR="$1"; project_set=1; shift
            else
                DOCKER_ARGS+=("$1"); shift
            fi
            ;;
    esac
done

case "$DIST" in
    bookworm|trixie) ;;
    *) echo "dbs: --dist must be 'bookworm' or 'trixie' (got '$DIST')" >&2; exit 1 ;;
esac

case "$ARCH" in
    64) DEB_ARCH="arm64"; GNU="aarch64-linux-gnu"; PLATFORM="linux/arm64"
        TOOLCHAIN="rpi-arm64.toolchain.cmake"; CROSS="crossbuild-essential-arm64" ;;
    32) DEB_ARCH="armhf"; GNU="arm-linux-gnueabihf"; PLATFORM="linux/arm/v7"
        TOOLCHAIN="rpi-armhf.toolchain.cmake"; CROSS="crossbuild-essential-armhf" ;;
    *)  echo "dbs: --arch must be '32' or '64' (got '$ARCH')" >&2; exit 1 ;;
esac

DBS_HOME="${DBS_HOME:-$HOME/dbs}"
REPO_GIT_URL="git@github.com:DroneProUkr/droneprorepo.git"
# A clone of droneprorepo used as a local file repo. Its pool/<dist>/main/
# directories hold the .deb files (all arches mixed, exactly like the real
# repo). dbs only adds/removes files here — never git add/commit — so the new
# packages can be reviewed and committed by hand.
LOCALREPO_DIR="${DBS_REPO_DIR:-$DBS_HOME/droneprorepo}"
LOCALREPO="$LOCALREPO_DIR/pool/$DIST/main"

# Make sure the droneprorepo clone exists; clone it on first use.
ensure_localrepo() {
    if [ -d "$LOCALREPO_DIR/.git" ]; then
        return 0
    fi
    if [ -e "$LOCALREPO_DIR" ] && [ -n "$(ls -A "$LOCALREPO_DIR" 2>/dev/null)" ]; then
        echo "dbs: '$LOCALREPO_DIR' exists but is not a git clone of the package repo" >&2
        echo "dbs: remove it or set DBS_REPO_DIR to a droneprorepo checkout" >&2
        exit 1
    fi
    echo "dbs: cloning package repo $REPO_GIT_URL -> $LOCALREPO_DIR" >&2
    git clone "$REPO_GIT_URL" "$LOCALREPO_DIR"
}

# Publish one built .deb into the repo pool, keeping only the newest version of
# each package+arch. Prints a warning and returns non-zero (so the caller counts
# it as skipped) when a newer version is already present.
publish_deb() {
    local src="$1" pool="$2"
    local fname base arch rest version name
    fname="$(basename -- "$src")"
    base="${fname%.deb}"
    arch="${base##*_}"          # name_version_arch -> arch
    rest="${base%_*}"           # name_version
    version="${rest##*_}"       # version (Debian versions have no '_')
    name="${rest%_*}"           # name

    # Highest version of this same package+arch already in the pool, if any.
    local newest_ver="" f b fver
    for f in "$pool/${name}"_*_"${arch}.deb"; do
        [ -e "$f" ] || continue
        b="$(basename -- "$f")"; b="${b%.deb}"; b="${b%_*}"
        fver="${b##*_}"
        if [ -z "$newest_ver" ] || dpkg --compare-versions "$fver" gt "$newest_ver"; then
            newest_ver="$fver"
        fi
    done

    if [ -n "$newest_ver" ] && dpkg --compare-versions "$version" lt "$newest_ver"; then
        echo "dbs: WARNING: built $name $version is older than $newest_ver already in the repo — not publishing $fname" >&2
        return 1
    fi

    # Newer (or equal, or first) version wins: drop every older copy so the pool
    # keeps a single, newest version of this package+arch.
    for f in "$pool/${name}"_*_"${arch}.deb"; do
        [ -e "$f" ] || continue
        rm -f "$f"
    done
    cp "$src" "$pool/"
    if [ -n "$newest_ver" ] && [ "$newest_ver" != "$version" ]; then
        echo "dbs: published $name $version ($arch), replaced $newest_ver" >&2
    else
        echo "dbs: published $name $version ($arch)" >&2
    fi
    return 0
}

# Collapse a pool directory to a single newest version per package+arch, deleting
# every older duplicate. Distinct versions have distinct filenames, so there are
# no same-version ties to break here (those are handled when files are written).
dedupe_pool() {
    local pool="$1"
    local -A best_ver best_file
    local f b arch rest version name key
    for f in "$pool"/*.deb; do
        [ -e "$f" ] || continue
        b="$(basename -- "$f")"; b="${b%.deb}"
        arch="${b##*_}"; rest="${b%_*}"; version="${rest##*_}"; name="${rest%_*}"
        key="$name|$arch"
        if [ -z "${best_ver[$key]:-}" ]; then
            best_ver[$key]="$version"; best_file[$key]="$f"
        elif dpkg --compare-versions "$version" gt "${best_ver[$key]}"; then
            rm -f "${best_file[$key]}"
            best_ver[$key]="$version"; best_file[$key]="$f"
        else
            rm -f "$f"
        fi
    done
}

# git pull the package repo before publishing, resolving any divergence toward
# the higher package version (and toward the local copy when versions match).
# Always returns 0 so a repo/network hiccup never blocks the local publish; it is
# meant to be called as `if ! repo_sync; then ...` so errexit can't abort here.
repo_sync() {
    git -C "$LOCALREPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

    local branch
    branch="$(git -C "$LOCALREPO_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    if [ -z "$branch" ]; then
        echo "dbs: package repo in detached HEAD — skipping git pull" >&2
        return 0
    fi

    echo "dbs: git pull (origin/$branch) before publishing..." >&2
    if ! git -C "$LOCALREPO_DIR" fetch --quiet origin "$branch" 2>/dev/null; then
        echo "dbs: WARNING: git fetch failed — publishing against the local pool only" >&2
        return 0
    fi

    local upstream
    upstream="$(git -C "$LOCALREPO_DIR" rev-parse --quiet --verify FETCH_HEAD 2>/dev/null || true)"
    [ -z "$upstream" ] && upstream="$(git -C "$LOCALREPO_DIR" rev-parse --quiet --verify "origin/$branch" 2>/dev/null || true)"
    if [ -z "$upstream" ]; then
        echo "dbs: no origin/$branch yet — nothing to pull" >&2
        return 0
    fi

    if [ "$(git -C "$LOCALREPO_DIR" rev-parse HEAD 2>/dev/null || true)" != "$upstream" ]; then
        # A merge refuses to clobber a working-tree .deb that the incoming commit
        # also touches. Our packages are exactly such files — untracked (just
        # published, not yet committed) or tracked-but-modified (a same-version
        # rebuild). Set both kinds aside, restore a clean tree, merge, then reapply
        # them under the version rule (publish_deb keeps the newer one, local
        # content on a tie) so a local edit never blocks pulling everyone else's.
        local stash_dir="$CTX/repo-untracked"
        mkdir -p "$stash_dir"
        local saved=() rel
        # Untracked pool debs — no --exclude-standard, so a build that happens to
        # be .gitignore'd is still set aside and can win a version tie locally.
        while IFS= read -r rel; do
            case "$rel" in *.deb) ;; *) continue ;; esac
            mkdir -p "$stash_dir/$(dirname "$rel")"
            mv "$LOCALREPO_DIR/$rel" "$stash_dir/$rel" && saved+=("$rel")
        done < <(git -C "$LOCALREPO_DIR" ls-files --others -- pool 2>/dev/null)
        # Tracked pool debs modified in the worktree: copy aside, then check the
        # committed content back out so the merge sees a clean path.
        while IFS= read -r rel; do
            case "$rel" in *.deb) ;; *) continue ;; esac
            mkdir -p "$stash_dir/$(dirname "$rel")"
            cp "$LOCALREPO_DIR/$rel" "$stash_dir/$rel" 2>/dev/null && saved+=("$rel")
            git -C "$LOCALREPO_DIR" checkout -q -- "$rel" 2>/dev/null || true
        done < <(git -C "$LOCALREPO_DIR" diff --name-only -- pool 2>/dev/null)

        # -X ours: take our side for any genuine same-path conflict, so the merge
        # never stops half-done; higher versions are different files and merge in.
        if ! git -C "$LOCALREPO_DIR" merge --no-edit --no-stat -X ours "$upstream" >/dev/null 2>&1; then
            echo "dbs: WARNING: git merge failed — keeping the local pool unchanged" >&2
            git -C "$LOCALREPO_DIR" merge --abort >/dev/null 2>&1 || true
        fi

        for rel in ${saved[@]+"${saved[@]}"}; do
            mkdir -p "$LOCALREPO_DIR/$(dirname "$rel")"
            publish_deb "$stash_dir/$rel" "$LOCALREPO_DIR/$(dirname "$rel")" >/dev/null 2>&1 || true
        done
    fi

    # The merge can pull an older copy alongside a newer one (a package, two
    # versions, two filenames) — collapse this dist's pool to the newest of each.
    dedupe_pool "$LOCALREPO"
    return 0
}

PROJECT_DIR="$(cd -- "$PROJECT_DIR" && pwd)"
if [ ! -f "$PROJECT_DIR/debian/control" ]; then
    echo "dbs: '$PROJECT_DIR' has no debian/control — not a buildable project" >&2
    echo "dbs: run 'dbs init' there first" >&2
    exit 1
fi

host_deps_file="$PROJECT_DIR/debian/dbs-host-deps"
if [ -f "$host_deps_file" ]; then
    HOST_DEPS="$(sed 's/#.*//' "$host_deps_file" | tr '\n' ' ') $HOST_DEPS"
fi
HOST_DEPS="$(printf '%s' "$HOST_DEPS" | tr -s '[:space:]' ' ' | sed 's/^ *//; s/ *$//')"
for dep in $HOST_DEPS; do
    case "$dep" in
        [!a-z0-9]*|*[!a-z0-9+.-]*)
            echo "dbs: invalid host-dep '$dep' — expected a bare package name" >&2
            exit 1 ;;
    esac
done
[ -n "$HOST_DEPS" ] && echo "dbs: extra host build tooling: $HOST_DEPS" >&2

# --build-var KEY=VALUE entries are forwarded into the build container as
# environment variables (see run_args below), where debian/rules picks them up
# as make variables. Require a well-formed KEY so the value can't smuggle in a
# second `-e` token or an empty/odd variable name.
for kv in ${BUILD_VARS[@]+"${BUILD_VARS[@]}"}; do
    case "$kv" in
        [A-Za-z_]*=*) : ;;
        *) echo "dbs: invalid --build-var '$kv' — expected KEY=VALUE with KEY a shell identifier" >&2; exit 1 ;;
    esac
    case "${kv%%=*}" in
        *[!A-Za-z0-9_]*)
            echo "dbs: invalid --build-var '$kv' — KEY must match [A-Za-z_][A-Za-z0-9_]*" >&2; exit 1 ;;
    esac
done
[ "${#BUILD_VARS[@]}" -gt 0 ] && echo "dbs: build vars: ${BUILD_VARS[*]}" >&2

CTX="$(mktemp -d)"
trap 'rm -rf "$CTX"' EXIT
cp "$BUILDER_DIR/Dockerfile" \
   "$BUILDER_DIR/crossbuild" \
   "$BUILDER_DIR/dbs-host-deps" \
   "$BUILDER_DIR/aarch64-linux-gnu-pkg-config" \
   "$BUILDER_DIR/arm-linux-gnueabihf-pkg-config" \
   "$BUILDER_DIR/rpi-arm64.toolchain.cmake" \
   "$BUILDER_DIR/rpi-armhf.toolchain.cmake" \
   "$CTX/"
mkdir -p "$CTX/debian"
cp "$PROJECT_DIR/debian/control" "$CTX/debian/control"

ensure_localrepo
mkdir -p "$LOCALREPO" "$CTX/localrepo"
# Stage the packages relevant to this build (target arch + arch-independent)
# out of the shared pool into the docker context.
n_repo=0
for f in "$LOCALREPO"/*_"$DEB_ARCH".deb "$LOCALREPO"/*_all.deb; do
    [ -e "$f" ] || continue
    cp "$f" "$CTX/localrepo/"
    n_repo=$((n_repo + 1))
done
if [ "$n_repo" -gt 0 ]; then
    echo "dbs: local repo: $n_repo prebuilt package(s) from $LOCALREPO" >&2
fi

GEN_CL=""
if [ ! -f "$PROJECT_DIR/debian/changelog" ]; then
    GEN_CL="$CTX/changelog"
    echo "dbs: no debian/changelog — generating from git history" >&2
    python3 "$BUILDER_DIR/dbs-changelog" "$PROJECT_DIR" > "$GEN_CL"
    echo "dbs: generated $(head -n1 "$GEN_CL")" >&2
fi

if [ "$NATIVE" -eq 1 ]; then
    TARGET="native"; BUILD_PLATFORM="$PLATFORM"; TAG="dbs-builder:${DIST}-${DEB_ARCH}-native"
    mode_note=" (native/QEMU)"
else
    TARGET="cross";  BUILD_PLATFORM="linux/amd64"; TAG="dbs-builder:${DIST}-${DEB_ARCH}"
    mode_note=""
fi

if [ "$LOCAL" -eq 1 ]; then
    echo "dbs: building $DEB_ARCH ($DIST)$mode_note -> build/$DIST/$DEB_ARCH/ (local artifacts)" >&2
else
    echo "dbs: building $DEB_ARCH ($DIST)$mode_note -> out/$DIST/$DEB_ARCH/" >&2
fi

build_args=(--build-arg "SUITE=$DIST" --build-arg "SYSROOT_PLATFORM=$PLATFORM" \
            --build-arg "DEB_ARCH=$DEB_ARCH" \
            --build-arg "HOST_DEPS=$HOST_DEPS")
if [ "$NATIVE" -eq 0 ]; then
    build_args+=(--build-arg "CROSS_PKG=$CROSS")
fi

docker build --progress=plain "${DOCKER_ARGS[@]}" \
    --platform "$BUILD_PLATFORM" \
    --target "$TARGET" \
    --iidfile "$CTX/iid" \
    "${build_args[@]}" \
    -t "$TAG" "$CTX"
IMAGE_ID="$(cat "$CTX/iid")"

run_args=(--rm --platform "$BUILD_PLATFORM" -v "$PROJECT_DIR:/workspace"
          -e "DBS_DIST=$DIST"
          -e "DEB_HOST_ARCH=$DEB_ARCH"
          -e "DBS_HOST_UID=$(id -u)"
          -e "DBS_HOST_GID=$(id -g)")
if [ "$NATIVE" -eq 1 ]; then
    run_args+=(-e "DBS_NATIVE=1")
else
    run_args+=(-e "DEB_HOST_GNU_TYPE=$GNU"
               -e "CMAKE_TOOLCHAIN_FILE=/opt/$TOOLCHAIN")
fi
[ "$LOCAL" -eq 1 ] && run_args+=(-e "DBS_LOCAL=1")
# Forward --build-var KEY=VALUE entries so debian/rules can read them.
for kv in ${BUILD_VARS[@]+"${BUILD_VARS[@]}"}; do run_args+=(-e "$kv"); done
[ -n "$GEN_CL" ] && run_args+=(-v "$GEN_CL:/run/dbs/changelog:ro")

[ -t 1 ] && run_args+=(-t)
docker run "${run_args[@]}" "$IMAGE_ID"

if [ "$LOCAL" -eq 0 ] && [ "$PUBLISH" -eq 1 ]; then
    out_dir="$PROJECT_DIR/out/$DIST/$DEB_ARCH"
    if compgen -G "$out_dir/*.deb" >/dev/null; then
        mkdir -p "$LOCALREPO"
        if ! repo_sync; then
            echo "dbs: WARNING: package repo sync hit an error — continuing" >&2
        fi
        n_pub=0; n_skip=0
        for deb in "$out_dir"/*.deb; do
            if publish_deb "$deb" "$LOCALREPO"; then
                n_pub=$((n_pub + 1))
            else
                n_skip=$((n_skip + 1))
            fi
        done
        echo "dbs: published $n_pub package(s) to $LOCALREPO" >&2
        [ "$n_skip" -gt 0 ] && echo "dbs: skipped $n_skip older package(s)" >&2
        echo "dbs: review and 'git commit' the new .deb files in $LOCALREPO_DIR" >&2
    fi
fi
