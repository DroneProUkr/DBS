#!/bin/bash
set -euo pipefail
SYSROOT=/sysroot
WORKSPACE=/workspace
BUILD=/build/src

# Target suite / arch / triplet — provided by `dbs` via `docker run -e`, with
# the trixie/arm64 defaults kept for a bare `docker run`.
DBS_DIST="${DBS_DIST:-trixie}"
DEB_HOST_ARCH="${DEB_HOST_ARCH:-arm64}"
DEB_HOST_GNU_TYPE="${DEB_HOST_GNU_TYPE:-aarch64-linux-gnu}"

mkdir -p "$BUILD"
cp -r "$WORKSPACE"/. "$BUILD"
cd "$BUILD"

# Never carry a previous run's output tree into the build (it is bind-mounted
# back from the workspace) — it must not be packaged or re-copied.
rm -rf out

if [ ! -f debian/changelog ] && [ -f /run/dbs/changelog ]; then
    mkdir -p debian
    cp /run/dbs/changelog debian/changelog
fi

# Default the source format when the project ships none — like the changelog,
# it is synthesised into the private build tree, never onto the project on disk.
if [ ! -f debian/source/format ]; then
    mkdir -p debian/source
    printf '3.0 (native)\n' > debian/source/format
fi

if [ -n "${DBS_NATIVE:-}" ]; then
    # Native mode (dbs --native): this container already runs the target
    # architecture under QEMU, so there is no sysroot, cross toolchain, or
    # --host-arch — build in place exactly as the package would on real
    # hardware. Slower, but sidesteps every cross-compilation quirk (Python/Java
    # bindings, cmake configs that bake in absolute /usr paths, etc.).
    DEB_BUILD_OPTIONS="noautodbgsym nocheck" dpkg-buildpackage -us -uc -b
else
    # Cross mode: point the build at the target sysroot and cross toolchain.
    # Toolchain file: explicit arg wins, then the env from `dbs`, then arm64.
    export CMAKE_TOOLCHAIN_FILE="${1:-${CMAKE_TOOLCHAIN_FILE:-/opt/rpi-arm64.toolchain.cmake}}"

    cat "$SYSROOT"/var/lib/dpkg/info/*.shlibs > debian/shlibs.local 2>/dev/null || true

    export LD_LIBRARY_PATH="$SYSROOT/usr/lib/$DEB_HOST_GNU_TYPE:$SYSROOT/lib/$DEB_HOST_GNU_TYPE:$SYSROOT/usr/lib"

    DEB_BUILD_OPTIONS="noautodbgsym nocheck" dpkg-buildpackage -us -uc -b -d --host-arch "$DEB_HOST_ARCH"
fi

if [ -n "${DBS_LOCAL:-}" ]; then
    # Local mode: emit the raw installed build tree instead of .deb packages.
    # dpkg-buildpackage leaves each binary package's staged files under
    # debian/<pkg>/; hand those back as build/<dist>/<arch>/.
    OUTROOT="$WORKSPACE/build"
    OUTDIR="$OUTROOT/$DBS_DIST/$DEB_HOST_ARCH"
    rm -rf "$OUTDIR"
    mkdir -p "$OUTDIR"
    pkgs=()
    while IFS= read -r p; do [ -n "$p" ] && pkgs+=("$p"); done < <(dh_listpackages)
    if [ "${#pkgs[@]}" -eq 1 ] && [ -d "debian/${pkgs[0]}" ]; then
        # Single binary package — drop its tree straight into the arch dir.
        cp -a "debian/${pkgs[0]}/." "$OUTDIR"/
    else
        # Multiple packages — keep them separated by package name.
        for p in "${pkgs[@]}"; do
            [ -d "debian/$p" ] || continue
            mkdir -p "$OUTDIR/$p"
            cp -a "debian/$p/." "$OUTDIR/$p"/
        done
    fi
    echo "dbs: build artifacts in build/$DBS_DIST/$DEB_HOST_ARCH/" >&2
    ls -1 "$OUTDIR"
else
    # Sort artifacts into out/<dist>/<arch>/ inside the workspace.
    OUTROOT="$WORKSPACE/out"
    OUTDIR="$OUTROOT/$DBS_DIST/$DEB_HOST_ARCH"
    mkdir -p "$OUTDIR"
    cp ../*.deb "$OUTDIR"/
    echo "dbs: packages in out/$DBS_DIST/$DEB_HOST_ARCH/" >&2
    ls -1 "$OUTDIR"
fi

# The container runs as root, so artifacts written into the bind-mounted
# workspace land owned by root on the host. Hand the output tree back to the
# invoking user (UID/GID passed in by `dbs`).
if [ -n "${DBS_HOST_UID:-}" ]; then
    chown -R "$DBS_HOST_UID:${DBS_HOST_GID:-$DBS_HOST_UID}" "$OUTROOT"
fi
